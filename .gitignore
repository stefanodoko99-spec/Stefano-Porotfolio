# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The example file documents variable NAMES only and must be tracked.
!.env.example

# Blender writes a .blend1 (and .blend2, ...) beside every save: the previous
# version, kept as a local undo. Committing them doubles the weight of every
# scene edit to store a copy of the file that is already in the history.
*.blend1
*.blend2
*.blend[0-9]

# Blender bytecode from headless script runs
scripts/**/__pycache__/
assets/blender/previews/
bar-martiri/node_modules/
bar-martiri/dist/
